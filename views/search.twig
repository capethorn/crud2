{% extends "__layout.twig" %}

{% block content %}

<h1>Поиск</h1>

<form method="GET" class="row g-3">
    <div class="col-auto">
        <label class="form-label">Тип</label>
        <select name="type" class="form-select">
            <option value="Все" {% if old_type == 'Все' or old_type == '' %}selected{% endif %}>Все</option>
            {% for type in types %}
                <option value="{{ type.id }}" {% if old_type == type.id %}selected{% endif %}>
                    {{ type.name }}
                </option>
            {% endfor %}
        </select>
    </div>
    
    <div class="col-auto">
        <label class="form-label">Название</label>
        <input type="text" name="title" class="form-control" value="{{ old_title }}">
    </div>
    
    <div class="col-auto">
        <label class="form-label">Информация</label>
        <input type="text" name="info" class="form-control" value="{{ old_info }}">
    </div>
    
    <div class="col-auto" style="display: flex; align-items: end;">
        <button type="submit" class="btn btn-primary">Найти</button>
    </div>
</form>

<hr>

{% for item in objects %}
    <div style="border:1px solid #ccc; padding:10px; margin:5px 0;">
        <a href="/phone-object/{{ item.id }}">{{ item.title }}</a>
    </div>
{% else %}
    <div>Ничего не найдено</div>
{% endfor %}

{% endblock %}