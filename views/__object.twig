{% extends "__layout.twig" %}

{% block content %}
    <h1>{{ title }}</h1>
    
    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            <a href="/phone-object/{{ my_id }}?show=image" class="btn {% if active == 'image' %}btn-primary{% else %}btn-link{% endif %}">Картинка</a>
        </li>
        <li class="nav-item">
            <a href="/phone-object/{{ my_id }}?show=info" class="btn {% if active == 'info' %}btn-primary{% else %}btn-link{% endif %}">Описание</a>
        </li>
    </ul>
    
    <div class="container">
        {% if active == 'image' %}
            <div class="text-center">
                <img src="{{ image }}" alt="{{ title }}" style="max-width: 100%; max-height: 500px;">
            </div>
        {% elseif active == 'info' %}
            <div class="alert alert-info">
                {{ info }}
            </div>
        {% else %}
            <div class="description-content">
                <p>{{ description }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}