{% extends "__layout.twig" %}
{% from "macros.twig" import btn %}

{% block content %}
    <h1>{{ title }}</h1>
    
    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            {{ btn("Картинка", "/" ~ url_title ~ "?show=image", is_image, "primary") }}
        </li>
        <li class="nav-item">
            {{ btn("Описание", "/" ~ url_title ~ "?show=info", is_info, "primary") }}
        </li>
    </ul>
    
    <div class="container">
        {% if is_image %}
            <div class="text-center">
                <img src="{{ image }}" alt="{{ title }}" style="max-width: 100%; max-height: 500px;">
            </div>
        {% elseif is_info %}
            <div class="alert alert-info">
                {{ info }}
            </div>
        {% else %}
            <div class="description-content">
                <p>{{ description }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}