{% extends "__layout.twig" %}

{% block content %}
<div class="d-flex flex-row flex-nowrap gap-3 overflow-auto">
    {% for phone in phone_objects %}
    <div class="flex-shrink-0" style="width: 200px;">
        <div class="border p-2 d-flex flex-column justify-content-between" style="width: 100%;">
            <div class="img-thumbnail mb-2" style="width: 100%; height: 160px; overflow:hidden">
                <img src="{{ phone.image }}" 
                     style="height: 100%; width: 100%; object-fit: contain;" 
                     alt="{{ phone.title }}"
                     onerror="this.src='/images/eror.gif'">
            </div>
            <div class="d-flex flex-column">
                <a class="btn btn-primary btn-sm mb-1" href="#">{{ phone.title }}</a>
                <div class="d-flex justify-content-center small">
                    <a class="me-2" href="/phone/{{ phone.id }}/image">Картинка</a>
                    <a href="/phone/{{ phone.id }}/info">Описание</a>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}