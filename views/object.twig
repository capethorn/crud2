{% extends "__layout.twig" %}
{% from "macros.twig" import btn%}
{% block content %}
    <h1>{{title}}</h1>

    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            {{btn("Картинка", "/" ~ url_title ~ "/image", is_active == 'image', 'primary') }}
        </li>
        <li class="nav-item">
            {{btn("Описание", "/" ~ url_title ~ "/info", is_active == 'info', 'primary') }}
        </li>
    </ul>
    <div class="container">
        {% block objectContent %}{% endblock %}
    </div>
{% endblock %}