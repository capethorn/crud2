<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fa-brands fa-apple"></i>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">Главная</a>
                    </li>
                    {% for type in types %}
                        <li class="nav-item">
                            <a class="nav-link" href="/?type_id={{ type.id }}">{{ type.name|title }}</a>
                        </li>
                    {% endfor %}
                    <li class="nav-item">
                        <a class="nav-link" href="/search">Поиск</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/add">Добавить</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/type/add">Добавить тип</a>
                    </li>
                </ul>

                <form action="/set-welcome/" class="d-flex me-2">
                    <input type="text" name="message" class="form-control form-control-sm me-2">
                </form>
                
                {% if session_is_logged %}
                <form action="/logout" method="GET" class="d-flex">
                    <button type="submit" class="btn btn-sm btn-danger">Выйти</button>
                </form>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <div class="col-md-9">
                {% block content %}
                {% endblock %}
            </div>
            <div class="col-md-3">
                {% if history is defined and history|length > 0 %}
                <div class="card mt-3">
                    <div class="card-header">
                        Последние страницы
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for url in history %}
                            <li class="list-group-item">
                                <a href="{{ url }}">{{ url|url_decode }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</body>
</html>