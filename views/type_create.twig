{% extends "__layout.twig" %}

{% block content %}
    <h1>Добавление типа телефона</h1>
    <hr>

    {% if message %}
    <div class="alert alert-success">
        {{ message }}
    </div>
    {% endif %}

    <form action="" method="POST" enctype="multipart/form-data" class="row g-3 mb-5">
        <div class="col-6">
            <label class="form-label">Название типа</label>
            <input type="text" class="form-control" name="name" required>
        </div>
        <div class="col-6">
            <label class="form-label">Иконка/картинка</label>
            <input type="file" class="form-control" name="image" accept="image/*">
        </div>
        <div class="col-12 text-end">
            <button type="submit" class="btn btn-primary">Добавить тип</button>
        </div>
    </form>

    <hr>

    <h2>Существующие типы</h2>
    <div class="row mt-3">
        {% for type in existing_types %}
            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        {% if type.image %}
                            <img src="{{ type.image }}" alt="{{ type.name }}" style="width: 50px; height: 50px; object-fit: contain;">
                        {% else %}
                            <div style="width: 50px; height: 50px; background: #ccc; margin: 0 auto; border-radius: 50%;"></div>
                        {% endif %}
                        <h5 class="mt-2">{{ type.name }}</h5>
                        <small class="text-muted">ID: {{ type.id }}</small>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

{% endblock %}